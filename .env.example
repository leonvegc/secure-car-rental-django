# Copie este archivo como .env para desarrollo local. NUNCA suba .env al repositorio.
DEBUG=1
SECRET_KEY=cambie-esto-por-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
# Opcional en local (sin esto se usa SQLite). En Render lo pone el blueprint.
# DATABASE_URL=postgres://usuario:clave@localhost:5432/alquiler
# DB_SSL_REQUIRE=0
# En local no hay HTTPS
USAR_HTTPS=0
SESION_INACTIVIDAD_SEGUNDOS=60
# Contraseñas de los usuarios de prueba que crea `python manage.py seed`
SEED_SUPERADMIN_PASSWORD=
SEED_AUDITOR_PASSWORD=
SEED_AGENTE_PASSWORD=
